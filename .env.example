# Prime SDK Environment Variables Example
# Copy this file to .env and fill in your actual values

# Prime API Credentials (JSON format)
# Get these from your Prime web console under Settings -> APIs
PRIME_CREDENTIALS={"accessKey":"","passphrase":"","signingKey":"","portfolioId":"","svcAccountId":"","entityId":""}

# Example values for testing (replace with your actual IDs)
PORTFOLIO_ID=your-portfolio-id-here
PRODUCT_ID=SOL-USD
WALLET_ID=your-wallet-id-here  
ORDER_ID=your-order-id-here